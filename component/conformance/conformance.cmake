#
# awva_conformance: the component ABI's conformance checks on any component library
# (awva_conformance.cpp, docs/conformance.md). It needs only nsc.h, the loader and doctest.
# Included by component/CMakeLists.txt (awva's own components) and by CMakeLists.txt here (built on
# its own, for a host's CI).
#   AWVA_DOCTEST_DIR   doctest (third_party/doctest of awva unless given)
#
# awva_conformance_tests(<prefix> <library> [KNOWN <tag>...] [LABELS <label>...]): one ctest per
# check of the library, named <prefix><check>; KNOWN: its known failures (reported, not failed).
# Callable from any directory, a project that includes awva's too (a plugin's CI): the checks are
# listed when ctest runs (awva_conformance --list-test-cases, through doctest's doctestAddTests),
# not by a build step on awva_conformance, which only its own directory could add. <library> may
# be a generator expression ($<TARGET_FILE:...>).
set(_conf_dir "${CMAKE_CURRENT_LIST_DIR}")
if(NOT AWVA_DOCTEST_DIR)
  set(AWVA_DOCTEST_DIR "${_conf_dir}/../../third_party/doctest")
endif()
add_executable(awva_conformance "${_conf_dir}/awva_conformance.cpp")
target_include_directories(awva_conformance PRIVATE "${_conf_dir}/../include" "${AWVA_DOCTEST_DIR}")
target_compile_features(awva_conformance PRIVATE cxx_std_20)
target_link_libraries(awva_conformance PRIVATE ${CMAKE_DL_LIBS})
if(TARGET awva_host_options)
  target_link_libraries(awva_conformance PRIVATE awva_host_options)
endif()
# (a function sees its caller's variables, not these: the script's path is kept where any can read it)
set(AWVA_CONFORMANCE_ADD_TESTS "${AWVA_DOCTEST_DIR}/cmake/doctestAddTests.cmake" CACHE INTERNAL "")

function(awva_conformance_tests prefix library)
  cmake_parse_arguments(_c "" "" "KNOWN;LABELS" ${ARGN})
  list(JOIN _c_KNOWN "," _known)
  if(NOT _c_LABELS)
    set(_c_LABELS conformance)
  endif()
  string(SHA1 _h "${CMAKE_CURRENT_BINARY_DIR};${prefix};${library}")
  string(SUBSTRING "${_h}" 0 10 _h)
  set(_base "${CMAKE_CURRENT_BINARY_DIR}/awva_conformance_${_h}")
  get_property(_multi GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
  if(_multi)
    set(_cfg "-$<CONFIG>")
  else()
    set(_cfg "")
  endif()
  # run by ctest (its TEST_INCLUDE_FILES): the checks of the library as tests, if it is built
  file(GENERATE OUTPUT "${_base}${_cfg}.cmake" CONTENT "# generated by awva_conformance_tests (component/conformance/conformance.cmake)
set(_exe [==[$<TARGET_FILE:awva_conformance>]==])
set(_lib [==[${library}]==])
if(EXISTS \"\${_exe}\" AND EXISTS \"\${_lib}\")
  set(TEST_TARGET awva_conformance)
  set(TEST_EXECUTABLE \"\${_exe}\")
  set(TEST_EXECUTOR \"\")
  set(TEST_WORKING_DIR [==[${CMAKE_CURRENT_BINARY_DIR}]==])
  set(TEST_SPEC \"\")
  set(TEST_EXTRA_ARGS \"\${_lib}\" [==[--known=${_known}]==])
  set(TEST_PROPERTIES \"\")
  set(TEST_ADD_LABELS 0)
  set(TEST_PREFIX [==[${prefix}]==])
  set(TEST_SUFFIX \"\")
  set(TEST_LIST _awva_conformance_checks)
  set(TEST_JUNIT_OUTPUT_DIR \"\")
  set(CTEST_FILE [==[${_base}${_cfg}_tests.cmake]==])
  include([==[${AWVA_CONFORMANCE_ADD_TESTS}]==])
  include([==[${_base}${_cfg}_tests.cmake]==])
  set_tests_properties(\${_awva_conformance_checks} PROPERTIES LABELS [==[${_c_LABELS}]==])
else()
  add_test([==[${prefix}NOT_BUILT]==] [==[${prefix}NOT_BUILT]==])
endif()
")
  if(_multi)
    file(WRITE "${_base}.cmake" "include(\"${_base}-\${CTEST_CONFIGURATION_TYPE}.cmake\" OPTIONAL)\n")
  endif()
  set_property(DIRECTORY APPEND PROPERTY TEST_INCLUDE_FILES "${_base}.cmake")
endfunction()
