# The parameters' text into the engines: param_text/<engine>.json (the source: each parameter's
# label, hover text and icon) as dsp/include/awva/param_text/<engine>.inc, one macro a parameter
# (AWVA_TEXT_<engine>_<name>: "label", "hover", "icon") that the engine's table names with
# AWVA_TEXT(engine, name) (awva/params.h); and the icons' vocabulary (assets/icons/icons.json) as
# docs/icons.md.
#
#   cmake -P tools/param_text.cmake             write the .inc files and docs/icons.md
#   cmake -DCHECK=ON -P tools/param_text.cmake  fail if one isn't what the sources give (ctest param_text)
#
# Checked on the way: every parameter has a label, a hover text and an icon whose concept (and
# modifier) is an icon in assets/icons and in icons.json; every icon there is in icons.json and the
# other way round; the parameters of a file are the ones its engine's table names, no more, no fewer
# (param_text/component.json: the component's own, in component/include/nsc/shim.h). The files are
# written with LF on every OS.
cmake_minimum_required(VERSION 3.25)
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_stale "")

# write (or, with CHECK, compare) one generated file
function(_emit target content)
  if(CHECK)
    set(old "")
    if(EXISTS "${target}")
      file(READ "${target}" old)
    endif()
    if(NOT old STREQUAL content)
      file(RELATIVE_PATH rel "${_root}" "${target}")
      set(_stale "${_stale} ${rel}" PARENT_SCOPE)
    endif()
  else()
    string(REGEX REPLACE "\n$" "" body "${content}")
    file(CONFIGURE OUTPUT "${target}" CONTENT "@body@" @ONLY NEWLINE_STYLE LF)
  endif()
endfunction()

# a C string literal of s
function(_c_literal s out)
  string(REPLACE "\\" "\\\\" s "${s}")
  string(REPLACE "\"" "\\\"" s "${s}")
  set(${out} "\"${s}\"" PARENT_SCOPE)
endfunction()

# --- the vocabulary: assets/icons/icons.json and the icons themselves ---
file(READ "${_root}/assets/icons/icons.json" _voc)
set(_concepts "")
set(_modifiers "")
string(JSON _nc LENGTH "${_voc}" concepts)
string(JSON _nm LENGTH "${_voc}" modifiers)
math(EXPR _lc "${_nc} - 1")
math(EXPR _lm "${_nm} - 1")
foreach(i RANGE ${_lc})
  string(JSON n GET "${_voc}" concepts ${i} name)
  list(APPEND _concepts "${n}")
endforeach()
foreach(i RANGE ${_lm})
  string(JSON n GET "${_voc}" modifiers ${i} name)
  list(APPEND _modifiers "${n}")
endforeach()
file(GLOB _svgs RELATIVE "${_root}/assets/icons" "${_root}/assets/icons/*.svg")
foreach(f IN LISTS _svgs)
  string(REGEX REPLACE "\\.svg$" "" n "${f}")
  if(n MATCHES "^mod-(.*)$")
    if(NOT CMAKE_MATCH_1 IN_LIST _modifiers)
      message(FATAL_ERROR "assets/icons/${f}: not a modifier of icons.json")
    endif()
  elseif(NOT n IN_LIST _concepts)
    message(FATAL_ERROR "assets/icons/${f}: not a concept of icons.json")
  endif()
endforeach()
foreach(n IN LISTS _concepts)
  if(NOT EXISTS "${_root}/assets/icons/${n}.svg")
    message(FATAL_ERROR "icons.json: concept ${n} has no assets/icons/${n}.svg")
  endif()
  set(_uses_${n} 0)
endforeach()
foreach(n IN LISTS _modifiers)
  if(NOT EXISTS "${_root}/assets/icons/mod-${n}.svg")
    message(FATAL_ERROR "icons.json: modifier ${n} has no assets/icons/mod-${n}.svg")
  endif()
  set(_muses_${n} 0)
endforeach()

# --- the parameters: param_text/<engine>.json ---
file(GLOB _files "${_root}/param_text/*.json")
list(SORT _files)
foreach(f IN LISTS _files)
  get_filename_component(engine "${f}" NAME_WE)
  file(READ "${f}" json)
  string(JSON e GET "${json}" engine)
  if(NOT e STREQUAL engine)
    message(FATAL_ERROR "param_text/${engine}.json: its engine is \"${e}\"")
  endif()
  if(engine STREQUAL "component")
    set(table "component/include/nsc/shim.h")
  else()
    set(table "dsp/include/awva/voice_${engine}.h")
  endif()
  file(READ "${_root}/${table}" src)
  string(REGEX MATCHALL "AWVA_TEXT\\(${engine}, [A-Za-z0-9_]+\\)" uses "${src}")
  set(named "")
  foreach(u IN LISTS uses)
    string(REGEX REPLACE "^AWVA_TEXT\\(${engine}, ([A-Za-z0-9_]+)\\)$" "\\1" u "${u}")
    list(APPEND named "${u}")
  endforeach()
  set(out "// SPDX-FileCopyrightText: 2026 Sorbet AI\n// SPDX-License-Identifier: Apache-2.0\n")
  string(APPEND out "// generated by tools/param_text.cmake from param_text/${engine}.json: edit that, then run\n")
  string(APPEND out "// cmake -P tools/param_text.cmake (ctest param_text checks this file is up to date).\n")
  string(APPEND out "// ${engine}'s parameters for people: label, hover text, icon (AWVA_TEXT, awva/params.h).\n")
  string(APPEND out "#pragma once\n\n")
  string(JSON np LENGTH "${json}" params)
  math(EXPR last "${np} - 1")
  set(listed "")
  foreach(i RANGE ${last})
    string(JSON name MEMBER "${json}" params ${i})
    if(NOT name MATCHES "^[A-Za-z0-9_]+$")
      message(FATAL_ERROR "param_text/${engine}.json: \"${name}\" is not a parameter name")
    endif()
    list(APPEND listed "${name}")
    foreach(k label hover icon)
      string(JSON v ERROR_VARIABLE err GET "${json}" params "${name}" ${k})
      if(err OR v STREQUAL "")
        message(FATAL_ERROR "param_text/${engine}.json: ${name} has no ${k}")
      endif()
      if(v MATCHES "@")
        message(FATAL_ERROR "param_text/${engine}.json: ${name}'s ${k} contains @")
      endif()
      set(${k} "${v}")
    endforeach()
    if(NOT icon MATCHES "^([a-z0-9-]+)(\\+([a-z0-9-]+))?$")
      message(FATAL_ERROR "param_text/${engine}.json: ${name}'s icon \"${icon}\" is not concept or concept+modifier")
    endif()
    set(c "${CMAKE_MATCH_1}")
    set(m "${CMAKE_MATCH_3}")
    if(NOT c IN_LIST _concepts)
      message(FATAL_ERROR "param_text/${engine}.json: ${name}'s icon concept \"${c}\" is not in assets/icons/icons.json")
    endif()
    math(EXPR _uses_${c} "${_uses_${c}} + 1")
    if(NOT m STREQUAL "")
      if(NOT m IN_LIST _modifiers)
        message(FATAL_ERROR "param_text/${engine}.json: ${name}'s icon modifier \"${m}\" is not in assets/icons/icons.json")
      endif()
      math(EXPR _muses_${m} "${_muses_${m}} + 1")
    endif()
    _c_literal("${label}" l)
    _c_literal("${hover}" h)
    _c_literal("${icon}" ic)
    string(APPEND out "#define AWVA_TEXT_${engine}_${name} ${l}, ${h}, ${ic}\n")
  endforeach()
  foreach(n IN LISTS named)
    if(NOT n IN_LIST listed)
      message(FATAL_ERROR "${table} names AWVA_TEXT(${engine}, ${n}): not in param_text/${engine}.json")
    endif()
  endforeach()
  foreach(n IN LISTS listed)
    if(NOT n IN_LIST named)
      message(FATAL_ERROR "param_text/${engine}.json: ${n} is not in ${table} (no AWVA_TEXT(${engine}, ${n}))")
    endif()
  endforeach()
  _emit("${_root}/dsp/include/awva/param_text/${engine}.inc" "${out}")
endforeach()

# --- docs/icons.md ---
set(md "<!-- generated by tools/param_text.cmake from assets/icons/icons.json and param_text/*.json: edit those -->\n")
string(APPEND md "# Parameter icons\n\n")
string(APPEND md "Every engine parameter has a label, a hover text and an icon (`awva::ParamDesc`, `nsc_param`: `label`, `hover`, `icon`; the source is `param_text/<engine>.json`). ")
string(APPEND md "The icon is a concept, `<concept>`, or a concept with a modifier, `<concept>+<modifier>`; the drawings are `assets/icons/<concept>.svg` and `assets/icons/mod-<modifier>.svg`, the names are stable.\n\n")
string(APPEND md "Every icon is 24 x 24, 1.5 px strokes with round caps and joins in `currentColor`; the only fills are the pedal's dot and the knockout. ")
string(APPEND md "To draw `<concept>+<modifier>`: the concept, then a disc of the background's colour at (19, 19), radius 5.5, then the modifier's mark. ")
string(APPEND md "At 14 to 16 px a modifier is a hint: the label and the hover text carry the meaning.\n\n")
string(APPEND md "A build with `AWVA_PARAM_TEXT 0` (an embedded host that shows no text) has none of the strings: the three are NULL. ")
string(APPEND md "The text is not part of a preset or of `schema_hash`: rewording it changes no stored value.\n\n")
string(APPEND md "A new parameter picks its concept (and modifier) from these; a new concept is a new icon here and a row in `assets/icons/icons.json`.\n\n")
string(APPEND md "## Concepts\n\n| icon | name | label | meaning | parameters |\n|---|---|---|---|---|\n")
foreach(i RANGE ${_lc})
  string(JSON n GET "${_voc}" concepts ${i} name)
  string(JSON l GET "${_voc}" concepts ${i} label)
  string(JSON mn GET "${_voc}" concepts ${i} meaning)
  string(APPEND md "| ![](../assets/icons/${n}.svg) | `${n}` | ${l} | ${mn} | ${_uses_${n}} |\n")
endforeach()
string(APPEND md "\n## Modifiers\n\n| mark | name | label | parameters |\n|---|---|---|---|\n")
foreach(i RANGE ${_lm})
  string(JSON n GET "${_voc}" modifiers ${i} name)
  string(JSON l GET "${_voc}" modifiers ${i} label)
  string(APPEND md "| ![](../assets/icons/mod-${n}.svg) | `${n}` | ${l} | ${_muses_${n}} |\n")
endforeach()
_emit("${_root}/docs/icons.md" "${md}")

if(_stale)
  message(FATAL_ERROR "out of date:${_stale} (cmake -P tools/param_text.cmake)")
endif()
