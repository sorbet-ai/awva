# The factory presets into the engines: presets/<engine>/*.preset.json (the source, in file name
# order: NN-<name>) as dsp/include/awva/presets/<engine>.inc, their texts as constants the engine
# reads at compile time (awva/preset.h factory()).
#
#   cmake -P tools/presets_inc.cmake             write the .inc files
#   cmake -DCHECK=ON -P tools/presets_inc.cmake  fail if one isn't what the files give (ctest presets_inc)
# The .inc files are written with LF on every OS (as .gitattributes keeps them).
cmake_minimum_required(VERSION 3.25) # (a script: the policies of the version it is written for)
get_filename_component(_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(GLOB _engines LIST_DIRECTORIES true "${_root}/presets/*")
list(SORT _engines)
set(_stale "")
foreach(dir IN LISTS _engines)
  if(NOT IS_DIRECTORY "${dir}")
    continue()
  endif()
  get_filename_component(engine "${dir}" NAME)
  file(GLOB _files "${dir}/*.preset.json")
  list(SORT _files)
  set(out "// SPDX-FileCopyrightText: 2026 Sorbet AI\n// SPDX-License-Identifier: Apache-2.0\n")
  string(APPEND out "// generated by tools/presets_inc.cmake from presets/${engine}/*.preset.json: edit those, then\n")
  string(APPEND out "// run cmake -P tools/presets_inc.cmake (ctest presets_inc checks this file is up to date).\n")
  string(APPEND out "// ${engine}'s factory presets in their order, as text (the engine reads them at compile time).\n")
  set(i 0)
  set(names "")
  foreach(f IN LISTS _files)
    file(READ "${f}" text)
    if(text MATCHES "\\)awva-preset\"")
      message(FATAL_ERROR "${f} contains )awva-preset\" (the raw string's end)")
    endif()
    get_filename_component(fn "${f}" NAME)
    string(APPEND out "\n// presets/${engine}/${fn}\ninline constexpr char factory_json_${i}[] = R\"awva-preset(${text})awva-preset\";\n")
    list(APPEND names "factory_json_${i}")
    math(EXPR i "${i} + 1")
  endforeach()
  list(JOIN names ", " joined)
  string(APPEND out "\ninline constexpr int NUM_FACTORY_PRESETS = ${i};\ninline constexpr const char* const factory_json[] = {${joined}};\n")
  set(target "${_root}/dsp/include/awva/presets/${engine}.inc")
  if(CHECK)
    set(old "")
    if(EXISTS "${target}")
      file(READ "${target}" old)
    endif()
    if(NOT old STREQUAL out)
      list(APPEND _stale "${engine}")
    endif()
  else()
    # LF on every OS (file(WRITE) writes CRLF on Windows); @ONLY: the presets' text is inserted
    # as it is, never scanned for variables; CONFIGURE ends the file with a newline itself
    string(REGEX REPLACE "\n$" "" body "${out}")
    file(CONFIGURE OUTPUT "${target}" CONTENT "@body@" @ONLY NEWLINE_STYLE LF)
  endif()
endforeach()
if(_stale)
  message(FATAL_ERROR "dsp/include/awva/presets/*.inc out of date for: ${_stale} (cmake -P tools/presets_inc.cmake)")
endif()
